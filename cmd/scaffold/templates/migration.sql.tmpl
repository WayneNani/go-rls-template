{{- /* New migration: the table, its guards and its privileges. */ -}}
-- {{.Title}}, scoped to an org (generated by `make scaffold`; edit freely before it is applied anywhere).
-- {{.Name}}.read: viewer, editor, admin. {{.Name}}.write: editor, admin. RLS decides per org.

-- +goose Up
-- Bounded waits (squawk); local to goose's transaction.
set local lock_timeout = '5s';
set local statement_timeout = '60s';

create table app.{{.Plural}} (
  id         bigint generated always as identity primary key,
  org_id     bigint not null references app.orgs,
{{- range .Fields}}
{{- if eq .Type "text"}}
  {{.Name}} text not null check (char_length({{.Name}}) between 1 and 200),
{{- else if eq .Type "int"}}
  {{.Name}} bigint not null check ({{.Name}} >= 0),
{{- else if eq .Type "date"}}
  {{.Name}} date not null,
{{- else if eq .Type "bool"}}
  {{.Name}} boolean not null default false,
{{- end}}
{{- end}}
  version    bigint not null default 1,
  created_at timestamptz not null default now(),
  -- The label is unique per org; a duplicate arrives at its field (constraints.go).
  unique (org_id, {{.Label.Name}})
);

alter table app.{{.Plural}} enable row level security;
alter table app.{{.Plural}} force  row level security;
create policy owner_all on app.{{.Plural}} to app_owner using (true) with check (true);
create policy app_rw_read on app.{{.Plural}} for select to app_rw using (app.has_privilege('{{.Name}}.read', org_id));
create policy app_rw_write on app.{{.Plural}} for insert to app_rw with check (app.has_privilege('{{.Name}}.write', org_id));
create policy app_rw_update on app.{{.Plural}} for update to app_rw
  using (app.has_privilege('{{.Name}}.write', org_id)) with check (app.has_privilege('{{.Name}}.write', org_id));

-- No delete: add a policy, a grant and an RPC when the app needs one. Updates only to the
-- fields: org_id, version (trigger) and created_at stay as they are.
grant select, insert on app.{{.Plural}} to app_rw;
grant update ({{range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f.Name}}{{end}}) on app.{{.Plural}} to app_rw;

create trigger {{.Plural}}_audit after insert or update or delete on app.{{.Plural}}
  for each row execute function app.audit();
create trigger {{.Plural}}_version before update on app.{{.Plural}}
  for each row execute function app.bump_version();

insert into app.privileges (code) values ('{{.Name}}.read'), ('{{.Name}}.write');
insert into app.role_privileges (role_code, privilege_code) values
  ('viewer', '{{.Name}}.read'),
  ('editor', '{{.Name}}.read'), ('editor', '{{.Name}}.write'),
  ('admin',  '{{.Name}}.read'), ('admin',  '{{.Name}}.write');

-- +goose Down
delete from app.role_privileges where privilege_code in ('{{.Name}}.read', '{{.Name}}.write');
delete from app.privileges where code in ('{{.Name}}.read', '{{.Name}}.write');
drop table app.{{.Plural}};
