func (s {{.Camel}}Server) Update{{.Pascal}}(ctx context.Context, req *connect.Request[appv1.Update{{.Pascal}}Request]) (*connect.Response[appv1.Update{{.Pascal}}Response], error) {
	m := req.Msg
