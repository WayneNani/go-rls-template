{{- template "dates" .}}
{{- end}}
	var version int64
	err {{if not (.HasType "date")}}:{{end}}= s.withUser(ctx, func(q *db.Queries) error {
		// Locked only if the caller may update it (RLS); the lock keeps the check and the
		// update together. lock_timeout bounds the wait.
		current, err := q.Lock{{.Pascal}}(ctx, m.GetId())
		if err != nil {
