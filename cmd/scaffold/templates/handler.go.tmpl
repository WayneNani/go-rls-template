func (s {{.Camel}}Server) List{{.PluralPascal}}(ctx context.Context, req *connect.Request[appv1.List{{.PluralPascal}}Request]) (*connect.Response[appv1.List{{.PluralPascal}}Response], error) {
	size := pageSize(req.Msg.GetPageSize())
	after, err := decodePageToken(req.Msg.GetPageToken())
	if err != nil {
		return nil, connect.NewError(connect.CodeInvalidArgument, errors.New("invalid page_token"))
	}

	res := &appv1.List{{.PluralPascal}}Response{}
	err = s.withUser(ctx, func(q *db.Queries) error {
		// One extra row tells whether another page exists.
		rows, err := q.List{{.PluralPascal}}(ctx, db.List{{.PluralPascal}}Params{
			AfterCreatedAt: after.createdAt, AfterID: after.id, Query: strings.TrimSpace(req.Msg.GetQuery()), PageLimit: size + 1,
		})
		if err != nil {
			return err
		}
		if len(rows) > int(size) {
			rows = rows[:size]
			last := rows[len(rows)-1]
			res.NextPageToken = encodePageToken(last.CreatedAt, last.ID)
		}
		for _, r := range rows {
			res.{{.PluralPascal}} = append(res.{{.PluralPascal}}, &appv1.{{.Pascal}}{
				Id: r.ID, OrgId: r.OrgID, OrgName: r.OrgName, CreatedAt: timestamppb.New(r.CreatedAt), Version: r.Version,
{{- range .Fields}}
				{{.ProtoGo}}: r.{{.SQLC}}{{if eq .Type "date"}}.Format(time.DateOnly){{end}},
{{- end}}
			})
		}
		return nil
	})
	if err != nil {
		return nil, toConnect(ctx, err)
	}
	return connect.NewResponse(res), nil
}

