{{- define "rules"}}
{{- if eq .Type "text"}} [(buf.validate.field).cel = {
    id: "{{.Name}}"
    message: "must be 1 to 200 characters"
    expression: "this.trim().size() >= 1 && this.trim().size() <= 200"
  }]
{{- else if eq .Type "int"}} [(buf.validate.field).int64.gte = 0]
{{- else if eq .Type "date"}} [(buf.validate.field).cel = {
    id: "{{.Name}}"
    message: "must be a valid date (YYYY-MM-DD)"
    expression: "this.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')"
  }]
{{- else if eq .Type "bool"}} [(buf.validate.field).ignore = IGNORE_ALWAYS]
{{- end}}
{{- end -}}

{{- define "type"}}{{if eq .Type "int"}}int64{{else if eq .Type "bool"}}bool{{else}}string{{end}}{{end -}}

syntax = "proto3";

package app.v1;

import "authz/v1/authz.proto";
import "buf/validate/validate.proto";
import "google/protobuf/timestamp.proto";

option go_package = "{{.Module}}/gen/app/v1;appv1";

// {{.Pascal}}Service manages {{.HumanPlural}}, scoped to an org (generated by `make scaffold`).
// The interceptor checks the privilege in any org; the RLS policies decide per org.
service {{.Pascal}}Service {
  // List{{.PluralPascal}} returns the {{.HumanPlural}} the caller may read, newest first.
  rpc List{{.PluralPascal}}(List{{.PluralPascal}}Request) returns (List{{.PluralPascal}}Response) {
    option (authz.v1.privilege) = "{{.Name}}.read";
  }

  // Create{{.Pascal}} adds {{.A}} {{.Human}} to an org where the caller holds {{.Name}}.write.
  rpc Create{{.Pascal}}(Create{{.Pascal}}Request) returns (Create{{.Pascal}}Response) {
    option (authz.v1.privilege) = "{{.Name}}.write";
  }

  // Update{{.Pascal}} changes {{.A}} {{.Human}}. version is the one the caller read; if the {{.Human}}
  // changed since, it fails with ABORTED and the caller reloads (no lost update).
  rpc Update{{.Pascal}}(Update{{.Pascal}}Request) returns (Update{{.Pascal}}Response) {
    option (authz.v1.privilege) = "{{.Name}}.write";
  }
}

message List{{.PluralPascal}}Request {
  // Maximum number to return: 1 to 100, 0 means 50.
  int32 page_size = 1 [(buf.validate.field).int32 = {gte: 0, lte: 100}];
  // next_page_token from the previous response; empty for the first page.
  string page_token = 2 [(buf.validate.field).string.max_len = 512];
  // Only {{.HumanPlural}} whose {{.Label.Name}} contains this text, ignoring case; empty for all.
  // Send the same query with every page_token of the list.
  string query = 3 [(buf.validate.field).string.max_len = 200];
}

message List{{.PluralPascal}}Response {
  repeated {{.Pascal}} {{.Plural}} = 1;
  // Pass as page_token to get the next page; empty when there are no more.
  string next_page_token = 2;
}

message {{.Pascal}} {
  int64 id = 1;
  int64 org_id = 2;
  string org_name = 3;
  google.protobuf.Timestamp created_at = 4;
  // Send it back with Update{{.Pascal}}.
  int64 version = 5;
{{- range $i, $f := .Fields}}
{{- if eq $f.Type "date"}}
  // YYYY-MM-DD
{{- end}}
  {{template "type" $f}} {{$f.Name}} = {{add $i 6}};
{{- end}}
}

// Rules mirror the CHECK constraints of app.{{.Plural}}, which stay. Text is trimmed by the server.
message Create{{.Pascal}}Request {
  int64 org_id = 1 [(buf.validate.field).int64.gt = 0];
{{- range $i, $f := .Fields}}
  {{template "type" $f}} {{$f.Name}} = {{add $i 2}}{{template "rules" $f}};
{{- end}}
}

message Create{{.Pascal}}Response {
  int64 id = 1;
}

message Update{{.Pascal}}Request {
  int64 id = 1 [(buf.validate.field).int64.gt = 0];
  // The version the caller read ({{.Pascal}}.version).
  int64 version = 2 [(buf.validate.field).int64.gt = 0];
{{- range $i, $f := .Fields}}
  {{template "type" $f}} {{$f.Name}} = {{add $i 3}}{{template "rules" $f}};
{{- end}}
}

message Update{{.Pascal}}Response {
  int64 version = 1;
}
