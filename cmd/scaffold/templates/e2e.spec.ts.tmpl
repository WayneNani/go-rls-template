{{- define "fill"}}
{{- range slice .Fields 1}}
{{- if eq .Type "bool"}}
  await page.getByLabel("{{.Human}}", { exact: true }).check();
{{- else}}
  await page.getByLabel("{{.Human}}", { exact: true }).fill({{if eq .Type "int"}}"1"{{else if eq .Type "date"}}"2026-01-31"{{else}}"x"{{end}});
{{- end}}
{{- end}}
{{- end -}}

import { expect, type Page, test } from "@playwright/test";

import { expectAccessible } from "./axe";

// The {{.HumanPlural}} screen (generated by `make scaffold`): create, a taken {{.Label.Name}} at the field,
// edit, filter, a viewer without the create button; axe on the screen and every dialog and select.
// {{.Label.Human}}s start with "E2E ": make e2e deletes them afterwards (dev/e2e-clean.sql).

async function open{{.PluralPascal}}(page: Page, user: string) {
  await page.goto("/");
  await page.getByRole("link", { name: "Sign in" }).click();
  await page.getByPlaceholder("Enter any user/subject").fill(user);
  await page.getByRole("button", { name: "Sign-in" }).click();
  await expect(page.getByText("Your access")).toBeVisible();
  await page.getByRole("button", { name: "{{.Title}}", exact: true }).click();
  await expect(page.getByRole("searchbox", { name: "Filter {{.HumanPlural}}" })).toBeVisible();
}

// The values of every field but the {{.Label.Name}}, in an open dialog.
async function fillOthers(page: Page) {
{{- template "fill" .}}
}

test("{{.HumanPlural}}: create, taken {{.Label.Name}}, edit, filter, accessible, no CSP violation", async ({ page }) => {
  const reports: string[] = [];
  page.on("request", (r) => {
    if (new URL(r.url()).pathname === "/csp-report") reports.push(r.postData() ?? "");
  });
  await open{{.PluralPascal}}(page, "alice");
  const stamp = `${Date.now()}`;
  const [alpha, beta] = [`E2E ${stamp} alpha`, `E2E ${stamp} beta`];
  const label = page.getByLabel("{{.Label.Human}}", { exact: true });
  const create = async (value: string) => {
    await page.getByRole("button", { name: "New {{.Human}}" }).click();
    await page.getByRole("combobox", { name: "Organization" }).click();
    await page.getByRole("option", { name: "Acme" }).click();
    await label.fill(value);
    await fillOthers(page);
    await page.getByRole("button", { name: "Create" }).click();
  };

  await create(alpha);
  await expect(page.getByRole("cell", { name: alpha, exact: true })).toBeVisible();
  await expectAccessible(page, "{{.HumanPlural}}");

  await page.getByRole("button", { name: "New {{.Human}}" }).click();
  await expectAccessible(page, "new {{.Human}} dialog");
  await page.getByRole("combobox", { name: "Organization" }).click();
  await expectAccessible(page, "organization select");
  await page.keyboard.press("Escape");
  await page.keyboard.press("Escape");

  const taken = "{{.CapA}} {{.Human}} with this {{.Label.Name}} already exists.";
  await create(alpha);
  await expect(label).toHaveAttribute("aria-invalid", "true");
  await expect(label).toHaveAccessibleDescription(taken);
  await expectAccessible(page, "new {{.Human}} dialog with a field error");
  await page.getByRole("button", { name: "Cancel" }).click();

  await page.getByRole("button", { name: `Edit ${alpha}` }).click();
  await expectAccessible(page, "edit {{.Human}} dialog");
  await label.fill(beta);
  await page.getByRole("button", { name: "Save" }).click();
  await expect(page.getByRole("cell", { name: beta, exact: true })).toBeVisible();

  // Filter: case-insensitive, matched by the server.
  const filter = page.getByRole("searchbox", { name: "Filter {{.HumanPlural}}" });
  await filter.fill(`${stamp} BETA`);
  await expect(page.getByRole("cell", { name: beta, exact: true })).toBeVisible();
  await filter.fill(`${stamp} gamma`);
  await expect(page.getByText(`Nothing matches “${stamp} gamma”.`)).toBeVisible();
  await expectAccessible(page, "{{.HumanPlural}} filtered to nothing");
  expect(reports).toEqual([]);
});

test("a viewer sees {{.HumanPlural}} but cannot create them", async ({ page }) => {
  await open{{.PluralPascal}}(page, "bob");
  await expect(page.getByRole("button", { name: "New {{.Human}}" })).toHaveCount(0);
});
