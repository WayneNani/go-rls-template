{{- /*
Snippets for shared files. "queries", "e2e_clean" and "matrix_rows" are appended; the others go
above the "scaffold: ... above this line" markers (main.go, insertions).
*/ -}}

{{- define "queries"}}
-- {{.Title}} (make scaffold). Keyset pagination and filter like ListProjects.
-- name: List{{.PluralPascal}} :many
select t.id, {{range .Fields}}t.{{.Name}}, {{end}}t.created_at, t.version, o.id as org_id, o.name as org_name
  from app.{{.Plural}} t
  join app.orgs o on o.id = t.org_id
 where (sqlc.narg(after_created_at)::timestamptz is null
        or (t.created_at, t.id) < (sqlc.narg(after_created_at)::timestamptz, sqlc.narg(after_id)::bigint))
   and strpos(lower(t.{{.Label.Name}}), lower(sqlc.arg(query)::text)) > 0
 order by t.created_at desc, t.id desc
 limit sqlc.arg(page_limit)::int;

-- name: Create{{.Pascal}} :one
insert into app.{{.Plural}} (org_id{{range .Fields}}, {{.Name}}{{end}})
values (sqlc.arg(org_id){{range .Fields}}, sqlc.arg({{.Name}}){{end}})
returning id;

-- FOR UPDATE applies the RLS update policy: no row means missing, hidden or not writable.
-- name: Lock{{.Pascal}} :one
select version from app.{{.Plural}} where id = sqlc.arg(id) for update;

-- The version trigger bumps version.
-- name: Update{{.Pascal}} :one
update app.{{.Plural}}
   set {{range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f.Name}} = sqlc.arg({{$f.Name}}){{end}}
 where id = sqlc.arg(id)
returning version;
{{end}}

{{- define "e2e_clean"}}delete from app.{{.Plural}} where {{.Label.Name}} like 'E2E %';
{{end}}

