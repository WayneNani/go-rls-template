{{- define "constraint_fields"}}	"{{.Plural}}_org_id_{{.Label.Name}}_key": {"{{.Label.Name}}", "{{.A}} {{.Human}} with this {{.Label.Name}} already exists"},
{{- range .Fields}}
{{- if eq .Type "text"}}
	"{{$.Plural}}_{{.Name}}_check": {"{{.Name}}", "must be 1 to 200 characters"}, // also a proto rule
{{- else if eq .Type "int"}}
	"{{$.Plural}}_{{.Name}}_check": {"{{.Name}}", "must be greater than or equal to 0"}, // also a proto rule
{{- end}}
{{- end}}
{{end}}

{{- define "constraints_internal"}}	"{{.Plural}}_pkey":        "identity column",
	"{{.Plural}}_org_id_fkey": "RLS WITH CHECK ({{.Name}}.write in that org) fails first for an unknown org",
{{end}}

{{- define "sample_sql"}}{{if eq .Type "text"}}'x'{{else if eq .Type "int"}}1{{else if eq .Type "date"}}'2000-01-01'{{else}}true{{end}}{{end}}
{{- define "sample_go"}}{{if eq .Type "text"}}"x"{{else if eq .Type "int"}}1{{else if eq .Type "date"}}"2000-01-01"{{else}}true{{end}}{{end}}

{{- define "matrix_seed"}}insert into app.{{.Plural}} (org_id{{range .Fields}}, {{.Name}}{{end}})
select id, name || ' {{.Human}}'{{range slice .Fields 1}}, {{template "sample_sql" .}}{{end}} from app.orgs;
{{end}}

{{- define "matrix_calls"}}	// {{.Title}} (make scaffold).
	{{.PluralCamel}}Client := appv1connect.New{{.Pascal}}ServiceClient(srv.Client(), srv.URL)
	calls["List{{.PluralPascal}}"] = call{"app.v1.{{.Pascal}}Service.List{{.PluralPascal}}", func(ctx context.Context, u string) error {
		res, err := {{.PluralCamel}}Client.List{{.PluralPascal}}(ctx, as(u, ids, &appv1.List{{.PluralPascal}}Request{}))
		visible = nil
		if err != nil {
			return err
		}
		for _, r := range res.Msg.Get{{.PluralPascal}}() {
			if !slices.Contains(visible, r.GetOrgName()) {
				visible = append(visible, r.GetOrgName())
			}
		}
		return nil
	}}
	for _, org := range []string{"Acme", "Globex"} {
		calls["Create{{.Pascal}} in "+org] = call{"app.v1.{{.Pascal}}Service.Create{{.Pascal}}", func(ctx context.Context, u string) error {
			_, err := {{.PluralCamel}}Client.Create{{.Pascal}}(ctx, as(u, ids, &appv1.Create{{.Pascal}}Request{
				OrgId: ids[org], {{.Label.ProtoGo}}: "by " + u,{{range slice .Fields 1}} {{.ProtoGo}}: {{template "sample_go" .}},{{end}}
			}))
			return err
		}}
		calls["Update{{.Pascal}} in "+org] = call{"app.v1.{{.Pascal}}Service.Update{{.Pascal}}", func(ctx context.Context, u string) error {
			var id, version int64
			err := db.Admin.QueryRow(ctx, "select id, version from app.{{.Plural}} where {{.Label.Name}} = $1", org+" {{.Human}}").Scan(&id, &version)
			if err != nil {
				return err
			}
			_, err = {{.PluralCamel}}Client.Update{{.Pascal}}(ctx, as(u, ids, &appv1.Update{{.Pascal}}Request{
				Id: id, Version: version, {{.Label.ProtoGo}}: org + " {{.Human}}",{{range slice .Fields 1}} {{.ProtoGo}}: {{template "sample_go" .}},{{end}}
			}))
			return err
		}}
	}

{{end}}

